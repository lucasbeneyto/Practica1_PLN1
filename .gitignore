# Mantener la fuente LaTeX y los estilos oficiales ACL, no los artefactos de compilación.
/memoria/*
!/memoria/memoria.tex
!/memoria/acl.sty
!/memoria/acl_natbib.bst

# Configuración local del editor.
.vscode/

# Pesos, checkpoints y configuraciones locales de los modelos.
/gpt2_weights/

# Artefactos de Python y Jupyter.
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.tmp
*.partial
.venv/
dist/
build/

# Salidas experimentales.
figures/
runs/

planning/

# Corpus, descargas y cachés de datos (se regeneran con los scripts).
/data/

# Cachés, checkpoints y salidas del piloto de los experimentos 2 y 3.
/experimentos_2_y_3/cache_datos_exp2/
/experimentos_2_y_3/pesos/*
!/experimentos_2_y_3/pesos/learned/
!/experimentos_2_y_3/pesos/rope/
/experimentos_2_y_3/pesos/learned/*
/experimentos_2_y_3/pesos/rope/*

# Solo publicaremos el mejor checkpoint DACSA definitivo de cada modelo.
!/experimentos_2_y_3/pesos/learned/best_dacsa_seed42.pt
!/experimentos_2_y_3/pesos/rope/best_dacsa_seed42.pt
/experimentos_2_y_3/resultados_exp2/piloto/
/experimentos_2_y_3/figuras_exp2/piloto/

# Solo generaremos PNG; conservamos localmente los PDF de ejecuciones anteriores.
/experimentos_2_y_3/figuras_exp2/**/*.pdf
/experimentos_2_y_3/figuras_exp3/**/*.pdf
