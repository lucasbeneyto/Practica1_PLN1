# Mantener solo la fuente LaTeX de la memoria bajo control de versiones.
/memoria/*
!/memoria/memoria.tex

# Pesos del modelo GPT-2: se descargan con el paquete (superan el límite de 100 MB de GitHub).
gpt2_weights/*.safetensors
gpt2_weights/*.bin
gpt2_weights/*.pt
gpt2_weights/*.h5
gpt2_weights/token_cache/
# Ignorar checkpoints intermedios de todas las corridas; conservar solo best.pt.
gpt2_weights/**/*.pt
!gpt2_weights/best.pt
!gpt2_weights/**/best.pt

# Artefactos de Python y Jupyter.
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
dist/
build/

# Salidas experimentales.
figures/
runs/

planning/

# Datos descargados y derivados de OPUS-100 (se regeneran con el script).
data/opus100_en-es_*
